# Paper trading: fake money, real Binance prices. No exchange account or API key is used.
# MODE=crypto: spot, long only, top coins. MODE=gold: gold price (PAXG), long or short with leverage.
# Gold setup used on the server: MODE=gold START_PKR=2000 LEVERAGE=20 RISK_PCT=20 MAX_STOP_PCT=1.5 INTERVAL=1h
#   AI_EVERY_HOURS=3 MAX_HOLD_HOURS=48 FEE_PCT=0.05 SLIPPAGE_PCT=0.02 TRADE_WEEKENDS=0
#   current: LEVERAGE=10 RISK_PCT=3 MARGIN_PKR=0 MAX_OPEN=2 MAX_TRADES_PER_DAY=4 DAILY_LOSS_STOP_PCT=6 MIN_CONFIDENCE=65 MIN_ORDER_USDT=0.5
MODE=crypto
LEVERAGE=1
RISK_PCT=100
MARGIN_PKR=0
START_PKR=1500
MAX_OPEN=1
MAX_STOP_PCT=4
MAX_TRADES_PER_DAY=3
DAILY_LOSS_STOP_PCT=3
MAX_HOLD_HOURS=120
MIN_CONFIDENCE=60
UNIVERSE=25
INTERVAL=4h
AI_EVERY_HOURS=4
TIMEZONE=Asia/Karachi

# Gemini (free key from aistudio.google.com); first model, then fallback
GEMINI_API_KEY=
GEMINI_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite

# Gmail with an App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# comma separated
REPORT_TO=
TRADE_ALERTS=1
