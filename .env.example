# ---------- Mode ----------
# testnet = fake money (default). live = REAL money.
MODE=testnet
# For live you must ALSO set this to yes. Two switches so it never happens by accident.
LIVE_TRADING_CONFIRM=no

# ---------- Binance keys ----------
# Testnet keys: testnet.binance.vision → login with GitHub → Generate HMAC_SHA256 Key
# Live keys: enable ONLY "Spot Trading". NEVER enable withdrawals. Restrict to your VPS IP.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ---------- Trading ----------
SYMBOL=BTCUSDT
INTERVAL=1h
# Max money the bot is allowed to use, even if the account has more
BUDGET_USDT=25
# After this much loss in one day, no new trades until tomorrow (UTC)
MAX_DAILY_LOSS_USDT=3
FEE_RATE=0.001
TICK_SECONDS=60

# ---------- Strategy (defaults are fine to start) ----------
EMA_FAST=20
EMA_SLOW=50
EMA_TREND=200
RSI_MAX=70
STOP_ATR=2
TARGET_ATR=3

# ---------- Dashboard ----------
PORT=3100
ADMIN_PASSWORD=change-me
